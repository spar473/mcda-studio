    "WeightProfile": {
      "additionalProperties": false,
      "description": "Raw swing ratings, one per criterion node, relative to that node's siblings.\n\nA rating expresses the importance of the swing from worst to best *over the scale range\nin use* - not abstract importance. Ratings need not sum to anything; they are normalised\nwithin each sibling group. An only child needs no rating (its local weight is 1).",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "judgements": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$": {
              "type": "number"
            }
          },
          "title": "Judgements",
          "type": "object"
        },
        "method": {
          "default": "swing",
          "title": "Method",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "WeightProfile",
      "type": "object"
    }
