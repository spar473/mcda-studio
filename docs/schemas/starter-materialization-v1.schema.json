{
  "$defs": {
    "AhpModel": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/AlternativeJudgements"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriteriaJudgements"
          },
          "title": "Criteria",
          "type": "array"
        }
      },
      "title": "AhpModel",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AlternativeJudgements": {
      "additionalProperties": false,
      "description": "The alternatives judged against each other on one leaf criterion.",
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "judgements": {
          "items": {
            "$ref": "#/$defs/PairwiseJudgement"
          },
          "title": "Judgements",
          "type": "array"
        }
      },
      "required": [
        "criterion_id"
      ],
      "title": "AlternativeJudgements",
      "type": "object"
    },
    "AnalysisConfiguration": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "mavt",
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "weight_profile_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Profile Id"
        }
      },
      "title": "AnalysisConfiguration",
      "type": "object"
    },
    "AnchorMode": {
      "description": "Where the 0-and-1 anchors of a *linear* value function come from.\n\nFIXED: ``lower``/``upper`` are stated by the user and never depend on the alternatives.\nLOCAL: anchors are the min/max over the alternatives currently in the project. This is an\n       explicit, recorded choice because adding an alternative can then change every\n       existing alternative's score.",
      "enum": [
        "fixed",
        "local"
      ],
      "title": "AnchorMode",
      "type": "string"
    },
    "BoundRequirement": {
      "additionalProperties": false,
      "description": "A numeric leaf's measurement must lie within the stated limits, in the leaf's unit.",
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "bound",
          "default": "bound",
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "maximum_inclusive": {
          "default": true,
          "title": "Maximum Inclusive",
          "type": "boolean"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "minimum_inclusive": {
          "default": true,
          "title": "Minimum Inclusive",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "name",
        "criterion_id",
        "unit"
      ],
      "title": "BoundRequirement",
      "type": "object"
    },
    "CategoricalDistribution": {
      "additionalProperties": false,
      "description": "Listed labels of a labelled scale with their probabilities.",
      "properties": {
        "kind": {
          "const": "categorical",
          "default": "categorical",
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "probabilities": {
          "items": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "array"
        }
      },
      "required": [
        "labels",
        "probabilities"
      ],
      "title": "CategoricalDistribution",
      "type": "object"
    },
    "CellRef": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id"
      ],
      "title": "CellRef",
      "type": "object"
    },
    "CellUncertainty": {
      "additionalProperties": false,
      "description": "One measurement's distribution, used instead of its entered value in SMAA runs.",
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "distribution": {
          "discriminator": {
            "mapping": {
              "categorical": "#/$defs/CategoricalDistribution",
              "discrete": "#/$defs/DiscreteDistribution",
              "triangular": "#/$defs/TriangularDistribution",
              "uniform": "#/$defs/UniformDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UniformDistribution"
            },
            {
              "$ref": "#/$defs/TriangularDistribution"
            },
            {
              "$ref": "#/$defs/DiscreteDistribution"
            },
            {
              "$ref": "#/$defs/CategoricalDistribution"
            }
          ],
          "title": "Distribution"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id",
        "distribution"
      ],
      "title": "CellUncertainty",
      "type": "object"
    },
    "ControlPoint": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        }
      },
      "required": [
        "x",
        "value"
      ],
      "title": "ControlPoint",
      "type": "object"
    },
    "CriteriaJudgements": {
      "additionalProperties": false,
      "description": "The children of one criterion (``None``: the top level) judged against each other.",
      "properties": {
        "judgements": {
          "items": {
            "$ref": "#/$defs/PairwiseJudgement"
          },
          "title": "Judgements",
          "type": "array"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "parent_id"
      ],
      "title": "CriteriaJudgements",
      "type": "object"
    },
    "CriterionNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_function": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "direct_rating": "#/$defs/DirectRatingValueFunction",
                  "linear": "#/$defs/LinearValueFunction",
                  "piecewise_linear": "#/$defs/PiecewiseLinearValueFunction",
                  "qualitative": "#/$defs/QualitativeValueFunction"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LinearValueFunction"
                },
                {
                  "$ref": "#/$defs/PiecewiseLinearValueFunction"
                },
                {
                  "$ref": "#/$defs/QualitativeValueFunction"
                },
                {
                  "$ref": "#/$defs/DirectRatingValueFunction"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Function"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CriterionNode",
      "type": "object"
    },
    "DirectRatingValueFunction": {
      "additionalProperties": false,
      "description": "The measurement *is* a rating on [min_rating, max_rating], rescaled linearly to [0, 1].",
      "properties": {
        "kind": {
          "const": "direct_rating",
          "default": "direct_rating",
          "title": "Kind",
          "type": "string"
        },
        "max_rating": {
          "default": 100.0,
          "title": "Max Rating",
          "type": "number"
        },
        "min_rating": {
          "default": 0.0,
          "title": "Min Rating",
          "type": "number"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "title": "DirectRatingValueFunction",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "increasing",
        "decreasing"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DiscreteDistribution": {
      "additionalProperties": false,
      "description": "Listed numeric values with their probabilities.",
      "properties": {
        "kind": {
          "const": "discrete",
          "default": "discrete",
          "title": "Kind",
          "type": "string"
        },
        "probabilities": {
          "items": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values",
        "probabilities"
      ],
      "title": "DiscreteDistribution",
      "type": "object"
    },
    "GroupUncertainty": {
      "additionalProperties": false,
      "description": "Weight uncertainty in one sibling group; a group without an entry keeps its ratings.\n\n``unknown``: local weights uniform on the group's simplex, Dirichlet(1, ..., 1).\n``rating_intervals``: each child's raw swing rating uniform on its stated [lower, upper], then\nnormalised within the group.",
      "properties": {
        "intervals": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          },
          "title": "Intervals",
          "type": "object"
        },
        "kind": {
          "enum": [
            "unknown",
            "rating_intervals"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "parent_id",
        "kind"
      ],
      "title": "GroupUncertainty",
      "type": "object"
    },
    "LabelsRequirement": {
      "additionalProperties": false,
      "description": "A labelled leaf's measurement must be one of the allowed labels.",
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "labels",
          "default": "labels",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "criterion_id",
        "allowed"
      ],
      "title": "LabelsRequirement",
      "type": "object"
    },
    "LinearPreferenceFunction": {
      "additionalProperties": false,
      "description": "No preference up to q, linear between q and p, full preference from p.",
      "properties": {
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "number"
        },
        "q": {
          "title": "Q",
          "type": "number"
        }
      },
      "required": [
        "q",
        "p"
      ],
      "title": "LinearPreferenceFunction",
      "type": "object"
    },
    "LinearValueFunction": {
      "additionalProperties": false,
      "description": "v(x) = (x-L)/(U-L) (increasing) or (U-x)/(U-L) (decreasing); L, U come from the scale.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "increasing"
        },
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "title": "LinearValueFunction",
      "type": "object"
    },
    "PairwiseJudgement": {
      "additionalProperties": false,
      "description": "``row`` is ``value`` times as important, or preferred, as ``column`` (1 <= value <= 9).",
      "properties": {
        "column": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Column",
          "type": "string"
        },
        "row": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Row",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "row",
        "column",
        "value"
      ],
      "title": "PairwiseJudgement",
      "type": "object"
    },
    "Performance": {
      "additionalProperties": false,
      "description": "One cell of the performance table: how an alternative performs on a leaf criterion.",
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id",
        "value"
      ],
      "title": "Performance",
      "type": "object"
    },
    "PiecewiseLinearValueFunction": {
      "additionalProperties": false,
      "description": "Interpolates linearly between ordered (x, value) points; domain = [x_first, x_last].",
      "properties": {
        "kind": {
          "const": "piecewise_linear",
          "default": "piecewise_linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ControlPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "PiecewiseLinearValueFunction",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "ahp": {
          "anyOf": [
            {
              "$ref": "#/$defs/AhpModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "analysis": {
          "$ref": "#/$defs/AnalysisConfiguration"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionNode"
          },
          "title": "Criteria",
          "type": "array"
        },
        "decision_maker": {
          "default": "",
          "title": "Decision Maker",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "performances": {
          "items": {
            "$ref": "#/$defs/Performance"
          },
          "title": "Performances",
          "type": "array"
        },
        "promethee": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrometheeModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requirements": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "bound": "#/$defs/BoundRequirement",
                    "labels": "#/$defs/LabelsRequirement"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/BoundRequirement"
                  },
                  {
                    "$ref": "#/$defs/LabelsRequirement"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirements"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "smaa": {
          "anyOf": [
            {
              "$ref": "#/$defs/SmaaModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sorting": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortingModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "weight_profiles": {
          "items": {
            "$ref": "#/$defs/WeightProfile"
          },
          "title": "Weight Profiles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Project",
      "type": "object"
    },
    "PrometheeCriterion": {
      "additionalProperties": false,
      "description": "PROMETHEE's inputs for one leaf; thresholds are in its units (its codes when labelled).",
      "properties": {
        "coding": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coding"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "maximise",
            "minimise"
          ],
          "title": "Direction",
          "type": "string"
        },
        "function": {
          "discriminator": {
            "mapping": {
              "linear": "#/$defs/LinearPreferenceFunction",
              "u_shape": "#/$defs/UShapeFunction",
              "usual": "#/$defs/UsualFunction",
              "v_shape": "#/$defs/VShapeFunction"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UsualFunction"
            },
            {
              "$ref": "#/$defs/UShapeFunction"
            },
            {
              "$ref": "#/$defs/VShapeFunction"
