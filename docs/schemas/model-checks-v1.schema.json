{
  "$defs": {
    "Origin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "human",
            "tool"
          ],
          "title": "Kind",
          "type": "string"
        },
        "proposed_by": {
          "minLength": 1,
          "title": "Proposed By",
          "type": "string"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "kind",
        "proposed_by"
      ],
      "title": "Origin",
      "type": "object"
    },
    "QuantityCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "lower_inclusive": {
          "default": true,
          "title": "Lower Inclusive",
          "type": "boolean"
        },
        "quantity_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Quantity Id",
          "type": "string"
        },
        "quantity_kind": {
          "enum": [
            "source",
            "formula"
          ],
          "title": "Quantity Kind",
          "type": "string"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "upper_inclusive": {
          "default": true,
          "title": "Upper Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "quantity_kind",
        "quantity_id",
        "unit"
      ],
      "title": "QuantityCheck",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "corrected_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Value"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "corrected",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/QuantityCheck"
      },
      "maxItems": 512,
      "title": "Checks",
      "type": "array"
    },
    "digest": {
      "title": "Digest",
      "type": "string"
    },
    "model_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Digest",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "project_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Project Fingerprint",
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/Review"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "project_fingerprint",
    "model_digest",
    "origin",
    "digest"
  ],
  "title": "ModelChecks",
  "type": "object"
}
