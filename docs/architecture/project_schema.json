{
  "$defs": {
    "AhpModel": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriteriaJudgements"
          },
          "title": "Criteria",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/AlternativeJudgements"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "AhpModel",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AlternativeJudgements": {
      "additionalProperties": false,
      "description": "The alternatives judged against each other on one leaf criterion.",
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "judgements": {
          "items": {
            "$ref": "#/$defs/PairwiseJudgement"
          },
          "title": "Judgements",
          "type": "array"
        }
      },
      "required": [
        "criterion_id"
      ],
      "title": "AlternativeJudgements",
      "type": "object"
    },
    "AnalysisConfiguration": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "mavt",
          "title": "Method",
          "type": "string"
        },
        "weight_profile_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Profile Id"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "title": "AnalysisConfiguration",
      "type": "object"
    },
    "AnchorMode": {
      "description": "Where the 0-and-1 anchors of a *linear* value function come from.\n\nFIXED: ``lower``/``upper`` are stated by the user and never depend on the alternatives.\nLOCAL: anchors are the min/max over the alternatives currently in the project. This is an\n       explicit, recorded choice because adding an alternative can then change every\n       existing alternative's score.",
      "enum": [
        "fixed",
        "local"
      ],
      "title": "AnchorMode",
      "type": "string"
    },
    "BoundRequirement": {
      "additionalProperties": false,
      "description": "A numeric leaf's measurement must lie within the stated limits, in the leaf's unit.",
      "properties": {
        "kind": {
          "const": "bound",
          "default": "bound",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "minimum_inclusive": {
          "default": true,
          "title": "Minimum Inclusive",
          "type": "boolean"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "maximum_inclusive": {
          "default": true,
          "title": "Maximum Inclusive",
          "type": "boolean"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "criterion_id",
        "unit"
      ],
      "title": "BoundRequirement",
      "type": "object"
    },
    "CategoricalDistribution": {
      "additionalProperties": false,
      "description": "Listed labels of a labelled scale with their probabilities.",
      "properties": {
        "kind": {
          "const": "categorical",
          "default": "categorical",
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "probabilities": {
          "items": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "array"
        }
      },
      "required": [
        "labels",
        "probabilities"
      ],
      "title": "CategoricalDistribution",
      "type": "object"
    },
    "CellRef": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id"
      ],
      "title": "CellRef",
      "type": "object"
    },
    "CellUncertainty": {
      "additionalProperties": false,
      "description": "One measurement's distribution, used instead of its entered value in SMAA runs.",
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "distribution": {
          "discriminator": {
            "mapping": {
              "categorical": "#/$defs/CategoricalDistribution",
              "discrete": "#/$defs/DiscreteDistribution",
              "triangular": "#/$defs/TriangularDistribution",
              "uniform": "#/$defs/UniformDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UniformDistribution"
            },
            {
              "$ref": "#/$defs/TriangularDistribution"
            },
            {
              "$ref": "#/$defs/DiscreteDistribution"
            },
            {
              "$ref": "#/$defs/CategoricalDistribution"
            }
          ],
          "title": "Distribution"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id",
        "distribution"
      ],
      "title": "CellUncertainty",
      "type": "object"
    },
    "ControlPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "x",
        "value"
      ],
      "title": "ControlPoint",
      "type": "object"
    },
    "CriteriaJudgements": {
      "additionalProperties": false,
      "description": "The children of one criterion (``None``: the top level) judged against each other.",
      "properties": {
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "judgements": {
          "items": {
            "$ref": "#/$defs/PairwiseJudgement"
          },
          "title": "Judgements",
          "type": "array"
        }
      },
      "required": [
        "parent_id"
      ],
      "title": "CriteriaJudgements",
      "type": "object"
    },
    "CriterionNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_function": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "direct_rating": "#/$defs/DirectRatingValueFunction",
                  "linear": "#/$defs/LinearValueFunction",
                  "piecewise_linear": "#/$defs/PiecewiseLinearValueFunction",
                  "qualitative": "#/$defs/QualitativeValueFunction"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LinearValueFunction"
                },
                {
                  "$ref": "#/$defs/PiecewiseLinearValueFunction"
                },
                {
                  "$ref": "#/$defs/QualitativeValueFunction"
                },
                {
                  "$ref": "#/$defs/DirectRatingValueFunction"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Function"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CriterionNode",
      "type": "object"
    },
    "DirectRatingValueFunction": {
      "additionalProperties": false,
      "description": "The measurement *is* a rating on [min_rating, max_rating], rescaled linearly to [0, 1].",
      "properties": {
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "kind": {
          "const": "direct_rating",
          "default": "direct_rating",
          "title": "Kind",
          "type": "string"
        },
        "min_rating": {
          "default": 0.0,
          "title": "Min Rating",
          "type": "number"
        },
        "max_rating": {
          "default": 100.0,
          "title": "Max Rating",
          "type": "number"
        }
      },
      "title": "DirectRatingValueFunction",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "increasing",
        "decreasing"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DiscreteDistribution": {
      "additionalProperties": false,
      "description": "Listed numeric values with their probabilities.",
      "properties": {
        "kind": {
          "const": "discrete",
          "default": "discrete",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        },
        "probabilities": {
          "items": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "array"
        }
      },
      "required": [
        "values",
        "probabilities"
      ],
      "title": "DiscreteDistribution",
      "type": "object"
    },
    "GroupUncertainty": {
      "additionalProperties": false,
      "description": "Weight uncertainty in one sibling group; a group without an entry keeps its ratings.\n\n``unknown``: local weights uniform on the group's simplex, Dirichlet(1, ..., 1).\n``rating_intervals``: each child's raw swing rating uniform on its stated [lower, upper], then\nnormalised within the group.",
      "properties": {
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "kind": {
          "enum": [
            "unknown",
            "rating_intervals"
          ],
          "title": "Kind",
          "type": "string"
        },
        "intervals": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          },
          "title": "Intervals",
          "type": "object"
        }
      },
      "required": [
        "parent_id",
        "kind"
      ],
      "title": "GroupUncertainty",
      "type": "object"
    },
    "LabelsRequirement": {
      "additionalProperties": false,
      "description": "A labelled leaf's measurement must be one of the allowed labels.",
      "properties": {
        "kind": {
          "const": "labels",
          "default": "labels",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "criterion_id",
        "allowed"
      ],
      "title": "LabelsRequirement",
      "type": "object"
    },
    "LinearPreferenceFunction": {
      "additionalProperties": false,
      "description": "No preference up to q, linear between q and p, full preference from p.",
      "properties": {
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "q": {
          "title": "Q",
          "type": "number"
        },
        "p": {
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "q",
        "p"
      ],
      "title": "LinearPreferenceFunction",
      "type": "object"
    },
    "LinearValueFunction": {
      "additionalProperties": false,
      "description": "v(x) = (x-L)/(U-L) (increasing) or (U-x)/(U-L) (decreasing); L, U come from the scale.",
      "properties": {
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "default": "increasing"
        }
      },
      "title": "LinearValueFunction",
      "type": "object"
    },
    "PairwiseJudgement": {
      "additionalProperties": false,
      "description": "``row`` is ``value`` times as important, or preferred, as ``column`` (1 <= value <= 9).",
      "properties": {
        "row": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Row",
          "type": "string"
        },
        "column": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Column",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "row",
        "column",
        "value"
      ],
      "title": "PairwiseJudgement",
      "type": "object"
    },
    "Performance": {
      "additionalProperties": false,
      "description": "One cell of the performance table: how an alternative performs on a leaf criterion.",
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id",
        "value"
      ],
      "title": "Performance",
      "type": "object"
    },
    "PiecewiseLinearValueFunction": {
      "additionalProperties": false,
      "description": "Interpolates linearly between ordered (x, value) points; domain = [x_first, x_last].",
      "properties": {
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "kind": {
          "const": "piecewise_linear",
          "default": "piecewise_linear",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ControlPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "PiecewiseLinearValueFunction",
      "type": "object"
    },
    "PrometheeCriterion": {
      "additionalProperties": false,
      "description": "PROMETHEE's inputs for one leaf; thresholds are in its units (its codes when labelled).",
      "properties": {
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "maximise",
            "minimise"
          ],
          "title": "Direction",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "function": {
          "discriminator": {
            "mapping": {
              "linear": "#/$defs/LinearPreferenceFunction",
              "u_shape": "#/$defs/UShapeFunction",
              "usual": "#/$defs/UsualFunction",
              "v_shape": "#/$defs/VShapeFunction"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UsualFunction"
            },
            {
              "$ref": "#/$defs/UShapeFunction"
            },
            {
              "$ref": "#/$defs/VShapeFunction"
            },
            {
              "$ref": "#/$defs/LinearPreferenceFunction"
            }
          ],
          "title": "Function"
        },
        "coding": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coding"
        }
      },
      "required": [
        "criterion_id",
        "direction",
        "weight",
        "function"
      ],
      "title": "PrometheeCriterion",
      "type": "object"
    },
    "PrometheeModel": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/PrometheeCriterion"
          },
          "title": "Criteria",
          "type": "array"
        }
      },
      "title": "PrometheeModel",
      "type": "object"
    },
    "QualitativeValueFunction": {
      "additionalProperties": false,
      "description": "Explicit label -> preference value mapping. Spacing is a judgement, never assumed.",
      "properties": {
        "kind": {
          "const": "qualitative",
          "default": "qualitative",
          "title": "Kind",
          "type": "string"
        },
        "mapping": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Mapping",
          "type": "object"
        }
      },
      "required": [
        "mapping"
      ],
      "title": "QualitativeValueFunction",
      "type": "object"
    },
    "Scale": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ScaleType"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "anchor_mode": {
          "$ref": "#/$defs/AnchorMode",
          "default": "fixed"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Scale",
      "type": "object"
    },
    "ScaleType": {
      "enum": [
        "categorical",
        "ordinal",
        "interval",
        "ratio"
      ],
      "title": "ScaleType",
      "type": "string"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "A named variation of the base model: another weight profile and/or other value functions.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "weight_profile_id": {
          "anyOf": [
            {
