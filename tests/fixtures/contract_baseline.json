{
  "schemas": {
    "Alternative-Input": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Alternative-Output": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "metadata"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AnalysisConfiguration-Input": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "mavt",
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Id"
        },
        "weight_profile_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight Profile Id"
        }
      },
      "title": "AnalysisConfiguration",
      "type": "object"
    },
    "AnalysisConfiguration-Output": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "default": "mavt",
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Id"
        },
        "weight_profile_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight Profile Id"
        }
      },
      "required": [
        "method",
        "weight_profile_id",
        "scenario_id",
        "parameters"
      ],
      "title": "AnalysisConfiguration",
      "type": "object"
    },
    "AnchorMode": {
      "description": "Where the 0-and-1 anchors of a *linear* value function come from.\n\nFIXED: ``lower``/``upper`` are stated by the user and never depend on the alternatives.\nLOCAL: anchors are the min/max over the alternatives currently in the project. This is an\n       explicit, recorded choice because adding an alternative can then change every\n       existing alternative's score.",
      "enum": [
        "fixed",
        "local"
      ],
      "title": "AnchorMode",
      "type": "string"
    },
    "ControlPoint": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        }
      },
      "required": [
        "x",
        "value"
      ],
      "title": "ControlPoint",
      "type": "object"
    },
    "CriterionNode-Input": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Scale-Input"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_function": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "direct_rating": "#/components/schemas/DirectRatingValueFunction-Input",
                  "linear": "#/components/schemas/LinearValueFunction-Input",
                  "piecewise_linear": "#/components/schemas/PiecewiseLinearValueFunction-Input",
                  "qualitative": "#/components/schemas/QualitativeValueFunction-Input"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/LinearValueFunction-Input"
                },
                {
                  "$ref": "#/components/schemas/PiecewiseLinearValueFunction-Input"
                },
                {
                  "$ref": "#/components/schemas/QualitativeValueFunction-Input"
                },
                {
                  "$ref": "#/components/schemas/DirectRatingValueFunction-Input"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Function"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CriterionNode",
      "type": "object"
    },
    "CriterionNode-Output": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Scale-Output"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_function": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "direct_rating": "#/components/schemas/DirectRatingValueFunction-Output",
                  "linear": "#/components/schemas/LinearValueFunction-Output",
                  "piecewise_linear": "#/components/schemas/PiecewiseLinearValueFunction-Output",
                  "qualitative": "#/components/schemas/QualitativeValueFunction-Output"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/LinearValueFunction-Output"
                },
                {
                  "$ref": "#/components/schemas/PiecewiseLinearValueFunction-Output"
                },
                {
                  "$ref": "#/components/schemas/QualitativeValueFunction-Output"
                },
                {
                  "$ref": "#/components/schemas/DirectRatingValueFunction-Output"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Function"
        }
      },
      "required": [
        "id",
        "name",
        "parent_id",
        "order",
        "description",
        "scale",
        "value_function"
      ],
      "title": "CriterionNode",
      "type": "object"
    },
    "DirectRatingValueFunction-Input": {
      "additionalProperties": false,
      "description": "The measurement *is* a rating on [min_rating, max_rating], rescaled linearly to [0, 1].",
      "properties": {
        "kind": {
          "const": "direct_rating",
          "default": "direct_rating",
          "title": "Kind",
          "type": "string"
        },
        "max_rating": {
          "default": 100.0,
          "title": "Max Rating",
          "type": "number"
        },
        "min_rating": {
          "default": 0.0,
          "title": "Min Rating",
          "type": "number"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "title": "DirectRatingValueFunction",
      "type": "object"
    },
    "DirectRatingValueFunction-Output": {
      "additionalProperties": false,
      "description": "The measurement *is* a rating on [min_rating, max_rating], rescaled linearly to [0, 1].",
      "properties": {
        "kind": {
          "const": "direct_rating",
          "default": "direct_rating",
          "title": "Kind",
          "type": "string"
        },
        "max_rating": {
          "default": 100.0,
          "title": "Max Rating",
          "type": "number"
        },
        "min_rating": {
          "default": 0.0,
          "title": "Min Rating",
          "type": "number"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "required": [
        "out_of_domain",
        "kind",
        "min_rating",
        "max_rating"
      ],
      "title": "DirectRatingValueFunction",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "increasing",
        "decreasing"
      ],
      "title": "Direction",
      "type": "string"
    },
    "LinearValueFunction-Input": {
      "additionalProperties": false,
      "description": "v(x) = (x-L)/(U-L) (increasing) or (U-x)/(U-L) (decreasing); L, U come from the scale.",
      "properties": {
        "direction": {
          "$ref": "#/components/schemas/Direction",
          "default": "increasing"
        },
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "title": "LinearValueFunction",
      "type": "object"
    },
    "LinearValueFunction-Output": {
      "additionalProperties": false,
      "description": "v(x) = (x-L)/(U-L) (increasing) or (U-x)/(U-L) (decreasing); L, U come from the scale.",
      "properties": {
        "direction": {
          "$ref": "#/components/schemas/Direction",
          "default": "increasing"
        },
        "kind": {
          "const": "linear",
          "default": "linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        }
      },
      "required": [
        "out_of_domain",
        "kind",
        "direction"
      ],
      "title": "LinearValueFunction",
      "type": "object"
    },
    "Performance": {
      "additionalProperties": false,
      "description": "One cell of the performance table: how an alternative performs on a leaf criterion.",
      "properties": {
        "alternative_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Alternative Id",
          "type": "string"
        },
        "criterion_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "alternative_id",
        "criterion_id",
        "value"
      ],
      "title": "Performance",
      "type": "object"
    },
    "PiecewiseLinearValueFunction-Input": {
      "additionalProperties": false,
      "description": "Interpolates linearly between ordered (x, value) points; domain = [x_first, x_last].",
      "properties": {
        "kind": {
          "const": "piecewise_linear",
          "default": "piecewise_linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/components/schemas/ControlPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "PiecewiseLinearValueFunction",
      "type": "object"
    },
    "PiecewiseLinearValueFunction-Output": {
      "additionalProperties": false,
      "description": "Interpolates linearly between ordered (x, value) points; domain = [x_first, x_last].",
      "properties": {
        "kind": {
          "const": "piecewise_linear",
          "default": "piecewise_linear",
          "title": "Kind",
          "type": "string"
        },
        "out_of_domain": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Out Of Domain",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/components/schemas/ControlPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "out_of_domain",
        "kind",
        "points"
      ],
      "title": "PiecewiseLinearValueFunction",
      "type": "object"
    },
